--[[
	Mobile
	------
	Only on touch devices. Library.MobileConfig() returns the current
	button settings; Library:SetMobileButtonOptions{ ... } writes them.
	Options: Transparency, Width, Height, IconSize, Mode ("tap" |
	"tap_twice" | "hold"), HoldDuration, Invisible, Locked.
]]
if Library.IsMobile then
	local mobileTab = Settings:SubTab("mobile")
	local mobileButton = mobileTab:Section("menu button", 1)
	local cfg = Library.MobileConfig()
	local function apply(options) Library:SetMobileButtonOptions(options) end

	mobileButton:Slider({ Text = "transparency", Min = 0, Max = 1, Decimals = 2, Default = cfg.Transparency or 0, Callback = function(v) apply({ Transparency = v }) end })
	mobileButton:Slider({ Text = "width", Min = 28, Max = 96, Default = cfg.Width or 44, Callback = function(v) apply({ Width = v }) end })
	mobileButton:Slider({ Text = "height", Min = 28, Max = 96, Default = cfg.Height or 44, Callback = function(v) apply({ Height = v }) end })
	mobileButton:Slider({ Text = "icon size", Min = 8, Max = 36, Default = cfg.IconSize or 18, Callback = function(v) apply({ IconSize = v }) end })

	local holdSlider
	mobileButton:Dropdown({
		Text = "toggle mode",
		Options = { "tap", "tap twice", "hold" },
		Default = cfg.Mode == "tap_twice" and "tap twice" or (cfg.Mode or "tap"),
		Callback = function(choice)
			local mode = (choice == "tap twice") and "tap_twice" or choice
			apply({ Mode = mode })
			if holdSlider then holdSlider.Instance.Visible = (mode == "hold") end
		end,
	})
	holdSlider = mobileButton:Slider({ Text = "hold duration", Min = 0.2, Max = 2, Decimals = 2, Suffix = " s", Default = cfg.HoldDuration or 0.6, Callback = function(v) apply({ HoldDuration = v }) end })
	if holdSlider then holdSlider.Instance.Visible = (cfg.Mode == "hold") end

	local behaviour = mobileTab:Section("behaviour", 1)
	behaviour:Toggle({ Text = "invisible button", Hint = "hides the button, tapping it still works", Default = cfg.Invisible == true, Callback = function(state) apply({ Invisible = state }) end })
	behaviour:Toggle({ Text = "lock the button", Hint = "keeps it in place", Default = cfg.Locked == true, Callback = function(state) apply({ Locked = state }) end })
	behaviour:Toggle({ Text = "show the button", Default = true, Callback = function(state) Library:SetMobileButtonVisible(state) end })
end


