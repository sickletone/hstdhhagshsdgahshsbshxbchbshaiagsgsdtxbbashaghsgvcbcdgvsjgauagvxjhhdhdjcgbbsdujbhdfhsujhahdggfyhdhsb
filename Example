--[[
	Window
	------
	Library:Window(Options)

	Options:
		Title      = string   -- text before the suffix
		Suffix     = string   -- accented text after the title (".win")
		Name       = string   -- ScreenGui name
		Width      = number   -- default 620 (560 on touch devices)
		Height     = number   -- default 560
		MinWidth   = number   -- resize floor
		MinHeight  = number   -- resize floor
		Position   = UDim2    -- default UDim2.fromScale(0.5, 0.5)
		TabStyle   = "top" | "side"
		TabWidth   = number   -- width of the side tab strip
		TabAlign   = "left" | "center" | "right" | "bottomleft" | "bottom" | "bottomright"
		TitleSize  = number   -- 9 to 28
		TitleAlign = "left" | "center" | "right"
		Discord    = { Invite = string, RememberJoins = boolean } -- optional
		KeySystem  = boolean, KeySettings = { ... }              -- optional
]]
