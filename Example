--[[
	Toggle
	------
	Section:Toggle(Options)

	Options:
		Text     = string   -- row label
		Flag     = string   -- config key (false to skip saving)
		Default  = boolean
		Hint     = string   -- small "?" tooltip next to the label
		Style    = "warning" | "danger" | "success" | "accent"
		Callback = function(state)

	Every toggle also takes these chained helpers:
		:Dependency(function(dep) ... end) -- child elements, only shown when on
		:SubToggle(Options)                -- one indented child toggle
		:Keybind(Options)                  -- the small key pill on the right
		:ColorPicker(Options)              -- the swatch on the right
		:Gear(function(panel) ... end)     -- extra settings in a popup
]]
global:Toggle({
	Text = "enable",
	Flag = "global_enable",
	Hint = "master switch for this tab",
	Callback = function(state) print("[cb] enable:", state) end,
})
	-- the key pill: double right click in game picks always / hold / toggle
	:Keybind({ Default = "F", Flag = "global_enable_key", Mode = "toggle" })
	:Gear(function(panel)
		panel:Slider({ Text = "delay", Flag = "global_delay", Min = 0, Max = 500, Suffix = " ms", Default = 60 })
		panel:Dropdown({ Text = "profile", Flag = "global_profile", Options = { "default", "custom" }, Default = "default" })
	end)

-- A toggle with children. The children are hidden until the toggle is on.
global:Toggle({ Text = "simulation", Flag = "simulation", Default = true })
	:Dependency(function(dep)
		dep:Toggle({ Text = "predict movement", Flag = "simulation_predict", Default = true })
		dep:Slider({ Text = "prediction step", Flag = "simulation_step", Min = 1, Max = 32, Default = 8 })
	end)

-- Blueprint style: indented child toggle, no parent needed.
global:SubToggle({ Text = "verbose logs", Flag = "verbose_logs", Hint = "prints every pass" })

-- RadioGroup / Segmented / Checkbox / ToggleSwitch / BoxToggle are all
-- covered in the components tab, this is just the everyday look.
global:Toggle({ Text = "motion smoothing", Flag = "motion_smoothing", Default = true })
	:Gear(function(panel)
		panel:Slider({ Text = "strength", Flag = "motion_strength", Min = 0, Max = 1, Decimals = 2, Default = 0.35 })
	end)

global:Toggle({ Text = "experimental hitbox", Flag = "exp_hitbox", Style = "warning", Hint = "may break in some places" })
global:Toggle({ Text = "force respawn", Flag = "force_respawn", Style = "danger", Hint = "kills the character" })


